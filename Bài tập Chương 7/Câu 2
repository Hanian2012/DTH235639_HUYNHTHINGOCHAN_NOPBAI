from tkinter import *
from math import *

# --- Tạo cửa sổ ---
frmPTB1 = Tk()
frmPTB1.title("PTB1")
frmPTB1.geometry("280x180")
frmPTB1.resizable(False, False)
# --- Tiêu đề ---
lbl_title = Label(frmPTB1, text="Phương Trình Bậc 1", font=("Arial", 12, "bold"))
lbl_title.grid(row=0, column=0, columnspan=2, pady=6)
# --- Hệ số a ---
lbl_a = Label(frmPTB1, text="Hệ số a:")
lbl_a.grid(row=1, column=0, sticky=E, padx=6, pady=2)
txt_a = Entry(frmPTB1, width=30)
txt_a.grid(row=1, column=1, padx=6, pady=2)
# --- Hệ số b ---
lbl_b = Label(frmPTB1, text="Hệ số b:")
lbl_b.grid(row=2, column=0, sticky=E, padx=6, pady=2)
txt_b = Entry(frmPTB1, width=30)
txt_b.grid(row=2, column=1, padx=6, pady=2)
# --- Kết quả ---
lbl_kq = Label(frmPTB1, text="Kết quả:")
lbl_kq.grid(row=4, column=0, sticky=E, padx=6, pady=2)
txt_kq = Entry(frmPTB1, width=30, state='readonly')
txt_kq.grid(row=4, column=1, padx=6, pady=2)
# --- Hàm giải phương trình bậc 1 ---
def giai():
    try:
        a = float(txt_a.get())
        b = float(txt_b.get())

        if a == 0:
            if b == 0:
                kq = "Vô số nghiệm"
            else:
                kq = "Vô nghiệm"
        else:
            x = -b / a
            kq = f"x = {x:.1f}"

        txt_kq.config(state='normal')
        txt_kq.delete(0, END)
        txt_kq.insert(0, kq)
        txt_kq.config(state='readonly')
    except:
        txt_kq.config(state='normal')
        txt_kq.delete(0, END)
        txt_kq.insert(0, "Lỗi nhập liệu!")
        txt_kq.config(state='readonly')
# --- Hàm tiếp ---
def tiep():
    txt_a.delete(0, END)
    txt_b.delete(0, END)
    txt_kq.config(state='normal')
    txt_kq.delete(0, END)
    txt_kq.config(state='readonly')
    txt_a.focus()
# --- Hàm thoát ---
def thoat():
    frmPTB1.destroy()
# --- Frame chứa các nút ---
btn_frame = Frame(frmPTB1)
btn_frame.grid(row=3, column=0, columnspan=2, pady=6)

btn_giai = Button(btn_frame, text="Giải", width=8, command=giai)
btn_giai.pack(side=LEFT, padx=2)

btn_tiep = Button(btn_frame, text="Tiếp", width=8, command=tiep)
btn_tiep.pack(side=LEFT, padx=2)

btn_thoat = Button(btn_frame, text="Thoát", width=8, command=thoat)
btn_thoat.pack(side=LEFT, padx=2)
# --- Chạy ---
txt_a.focus()
frmPTB1.mainloop()
